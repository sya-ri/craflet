{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "types": ["node"],
        "resolveJsonModule": true
    },
    "include": [
        "packages/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts",
        "tsdown.config.ts"
    ],
    "exclude": ["node_modules", "packages/cli/dist", "tests/fixtures"]
}
