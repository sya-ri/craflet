{
    "name": "craflet",
    "version": "0.1.0",
    "description": "Reproducible Minecraft servers, safe updates, configuration capture and cold backups.",
    "keywords": [
        "minecraft",
        "paper",
        "velocity",
        "server-management",
        "plugin-management",
        "backup",
        "cli"
    ],
    "homepage": "https://github.com/sya-ri/craflet#readme",
    "bugs": "https://github.com/sya-ri/craflet/issues",
    "type": "module",
    "bin": {
        "craflet": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "engines": {
        "node": ">=24.20.0 <27"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sya-ri/craflet.git",
        "directory": "packages/cli"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "tag": "latest"
    },
    "dependencies": {
        "@clack/prompts": "1.7.0",
        "@craflet/adapters": "workspace:*",
        "@craflet/core": "workspace:*",
        "@earendil-works/pi-tui": "0.84.3",
        "commander": "15.0.0"
    }
}
